# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key - server-side only, NEVER exposed to the browser.
# Used by API routes to write messages, moderate, and run the daily reset.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# A password you invent yourself. Protects the /admin dictionary page
# and the daily-reset cron endpoint from strangers.
ADMIN_SECRET=choose-a-long-random-string

# Same value as ADMIN_SECRET, used by Vercel Cron to call /api/cron/reset
CRON_SECRET=choose-a-long-random-string
